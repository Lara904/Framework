        <mxCell id="68IKeSOhdxkQSE21_PyE-209" parent="68IKeSOhdxkQSE21_PyE-208" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;top=0;left=0;bottom=0;right=0;dropTarget=0;collapsible=0;recursiveResize=0;expand=0;fontStyle=0;strokeColor=inherit;fillColor=#ffffff;" vertex="1">
          <mxGeometry height="68" width="1410" as="geometry" />
        </mxCell>
        <mxCell id="68IKeSOhdxkQSE21_PyE-210" parent="68IKeSOhdxkQSE21_PyE-209" style="connectable=0;recursiveResize=0;strokeColor=inherit;fillColor=#A7C942;align=center;fontStyle=1;fontColor=#FFFFFF;html=1;rowspan=1;colspan=2;whiteSpace=wrap;fillStyle=auto;" value="Template Usage Tips&lt;div&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-weight: 400; text-align: left; text-wrap-mode: wrap;&quot;&gt;This template captures almost all of the components of the SFS NG Landing zone that are relevant from an application perspective. It also includes components of a typical 3-Tier Web application, with REST API exposition and some batch processing for files. Not all applications will need all the components here and some applications may need to add additional components, the objective here is to provide a common starting point. In general the project should update the document to reflect their architecture. Here are some common checks&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="68" width="1410" as="geometry">
            <mxRectangle height="68" width="102" as="alternateBounds" />
