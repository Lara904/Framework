        </mxCell>
        <mxCell id="iPrzYRDzjuerr0liEWhQ-1" value="Not expected to use in the context of NG LZ App, unless there is a derogation" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1541.5" y="-362" width="200" height="42" as="geometry" />
