          <mxGeometry x="-4" y="10" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="O1lpKhGSZu71qgQ_a9Vs-44" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SFS REST API Exposition pattern&lt;/h1&gt;&lt;div&gt;Expose REST APIs from applications running in SFS AWS LZ accounts to other applications (with in LZ, On-Prem or Partners).&amp;nbsp;&lt;/div&gt;&lt;div&gt;The pattern uses APIC as the APIM solution and gateway, the components in AWS is acting like a proxy providing a secure connectivity from APIC (on-prem) to application (cloud)&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" parent="1" vertex="1">
          <mxGeometry x="11" y="-140" width="869" height="120" as="geometry" />
        </mxCell>
        <mxCell id="wpx-xS0hVz5jo0oU1wxI-25" value="Notes" parent="0" />
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-25" value="" style="group" parent="wpx-xS0hVz5jo0oU1wxI-25" vertex="1" connectable="0">
          <mxGeometry x="927" y="1034" width="689" height="100" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-11" value="The role of the Authorizer Lambda is to ensure only APIC can make requests to the API gateway. It is achieved by validating the &quot;Subject&quot; of the certificate presented by the client against the know subject name APIC client certificate. The lambda is also responsible for ensuring the presented client certificate is not revoked by checking it against a certificate revocation list (CRL).&amp;nbsp;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontSize=14;" parent="Qi_sAsrP5YPHp-HeFYlL-25" vertex="1">
          <mxGeometry x="60" width="629" height="100" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-12" value="12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" parent="Qi_sAsrP5YPHp-HeFYlL-25" vertex="1">
          <mxGeometry width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-27" value="" style="group" parent="wpx-xS0hVz5jo0oU1wxI-25" vertex="1" connectable="0">
          <mxGeometry x="929" y="944" width="689" height="80" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-23" value="WAF with WebACL rules protecting private ALB endpoint. Standard rules are provided by Firewall manager, but applications should have the option to additional rule groups if needed. Please note that WebACL used with WAF for private and public endpoints are different." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontSize=14;" parent="Qi_sAsrP5YPHp-HeFYlL-27" vertex="1">
          <mxGeometry x="58" width="629" height="80" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-24" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" parent="Qi_sAsrP5YPHp-HeFYlL-27" vertex="1">
          <mxGeometry x="-2" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-28" value="" style="group" parent="wpx-xS0hVz5jo0oU1wxI-25" vertex="1" connectable="0">
          <mxGeometry x="929" y="874" width="689" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-19" value="ACM provides publicly trusted certificates for API gateway and ALB" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontSize=14;" parent="Qi_sAsrP5YPHp-HeFYlL-28" vertex="1">
          <mxGeometry x="58" width="629" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-20" value="10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" parent="Qi_sAsrP5YPHp-HeFYlL-28" vertex="1">
          <mxGeometry x="-2" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-29" value="" style="group" parent="wpx-xS0hVz5jo0oU1wxI-25" vertex="1" connectable="0">
          <mxGeometry x="929" y="804" width="689" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-17" value="WAF with WebACL rules protecting public gateway endpoint. Standard rules are provided by Firewall manager, but applications should have the option to additional rule groups if needed." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontSize=14;" parent="Qi_sAsrP5YPHp-HeFYlL-29" vertex="1">
          <mxGeometry x="58" width="629" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-18" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" parent="Qi_sAsrP5YPHp-HeFYlL-29" vertex="1">
          <mxGeometry x="-2" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-30" value="" style="group" parent="wpx-xS0hVz5jo0oU1wxI-25" vertex="1" connectable="0">
          <mxGeometry x="929" y="694" width="690" height="100" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-5" value="Private hosted zone provides DNS names for the ALB. Note that the domain is used in &quot;split-dns&quot; mode and this is the private part. Split-DNS is required because API gateway requires the backend to have a certificate from a publicly verifiable CA, and to use ACM for certificate we need a public domain. We don&#39;t use the public hosted zone with private A records&amp;nbsp; to avoid unecessary leaking of IP address" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontSize=14;" parent="Qi_sAsrP5YPHp-HeFYlL-30" vertex="1">
          <mxGeometry x="58" width="630" height="100" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-6" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" parent="Qi_sAsrP5YPHp-HeFYlL-30" vertex="1">
          <mxGeometry x="-2" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-31" value="" style="group" parent="wpx-xS0hVz5jo0oU1wxI-25" vertex="1" connectable="0">
          <mxGeometry x="929" y="614" width="690" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-1" value="Public Hosted zone provides custom domain name required for the API Gateway. Hosts the DNS records for the API gateway and ownership verification records for ACM certificates needed for API gateway and ALB (c.f 5). Note that the domain is used in &quot;split-dns&quot; mode and this is the public part.&amp;nbsp;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontSize=14;" parent="Qi_sAsrP5YPHp-HeFYlL-31" vertex="1">
          <mxGeometry x="58" width="630" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-2" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" parent="Qi_sAsrP5YPHp-HeFYlL-31" vertex="1">
          <mxGeometry x="-2" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-32" value="" style="group" parent="wpx-xS0hVz5jo0oU1wxI-25" vertex="1" connectable="0">
          <mxGeometry x="930" y="544" width="690" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wpx-xS0hVz5jo0oU1wxI-22" value="ECS service providing the API. Application is expected to do validations on JWT and API keys as required by the APIC.&amp;nbsp;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontSize=14;" parent="Qi_sAsrP5YPHp-HeFYlL-32" vertex="1">
          <mxGeometry x="57" width="630" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wpx-xS0hVz5jo0oU1wxI-23" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" parent="Qi_sAsrP5YPHp-HeFYlL-32" vertex="1">
          <mxGeometry x="-3" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-33" value="" style="group" parent="wpx-xS0hVz5jo0oU1wxI-25" vertex="1" connectable="0">
          <mxGeometry x="930" y="454" width="690" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wpx-xS0hVz5jo0oU1wxI-20" value="Private ALB marks the begining of actual application layer. The ALB provides load balancing and request routing services to the application. ALB will route the request to the actual ECS service that provides the API. ALB could also be used for accessing the API internally within the application. ALB uses ACM certificate signed by AWS (not imported)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontSize=14;" parent="Qi_sAsrP5YPHp-HeFYlL-33" vertex="1">
          <mxGeometry x="57" width="630" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wpx-xS0hVz5jo0oU1wxI-21" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" parent="Qi_sAsrP5YPHp-HeFYlL-33" vertex="1">
          <mxGeometry x="-3" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-34" value="" style="group" parent="wpx-xS0hVz5jo0oU1wxI-25" vertex="1" connectable="0">
          <mxGeometry x="931" y="384" width="689" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wpx-xS0hVz5jo0oU1wxI-18" value="Private NLB supports the VPC link being the other end of the bridge. NLB is configured to route all traffic towards the application ALB" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontSize=14;" parent="Qi_sAsrP5YPHp-HeFYlL-34" vertex="1">
          <mxGeometry x="56" width="629" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wpx-xS0hVz5jo0oU1wxI-19" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" parent="Qi_sAsrP5YPHp-HeFYlL-34" vertex="1">
          <mxGeometry x="-4" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-35" value="" style="group" parent="wpx-xS0hVz5jo0oU1wxI-25" vertex="1" connectable="0">
          <mxGeometry x="930" y="314" width="689" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wpx-xS0hVz5jo0oU1wxI-16" value="VPC Link allows API gateway to connect to resources inside application VPC. Acts as bridge between API gateway and application VPC" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontSize=14;" parent="Qi_sAsrP5YPHp-HeFYlL-35" vertex="1">
          <mxGeometry x="57" width="629" height="60" as="geometry" />
        </mxCell>
        <mxCell id="wpx-xS0hVz5jo0oU1wxI-17" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" parent="Qi_sAsrP5YPHp-HeFYlL-35" vertex="1">
          <mxGeometry x="-3" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-37" value="" style="group" parent="wpx-xS0hVz5jo0oU1wxI-25" vertex="1" connectable="0">
          <mxGeometry x="931" y="54" width="690" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wpx-xS0hVz5jo0oU1wxI-6" value="APIC is the official API management solution for stellantis. All the APIs are published here and this is the entry point for all API consumers. The rest of the components in the architecture are meant for providing a secure connection between the APIC and application in SFS LZ. For details on publishing API in&amp;nbsp;https://shiftup.sharepoint.com/sites/COEAPI/SitePages/Publish-APIs-all-Lifecycle.aspx" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontSize=14;" parent="Qi_sAsrP5YPHp-HeFYlL-37" vertex="1">
          <mxGeometry x="56" width="630" height="90" as="geometry" />
        </mxCell>
        <mxCell id="wpx-xS0hVz5jo0oU1wxI-7" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" parent="Qi_sAsrP5YPHp-HeFYlL-37" vertex="1">
          <mxGeometry x="-4" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-38" value="" style="group" parent="wpx-xS0hVz5jo0oU1wxI-25" vertex="1" connectable="0">
          <mxGeometry x="927" y="1218" width="689" height="72" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-39" value="S3 buckets holding the trust store and CRL. This is in a shared account made accessible to all accounts in SFS LZ. This way authorizer lambda need not contact the actual PKI for getting the CRL.&lt;div&gt;Bucket name:&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;s3://s3-lzb-prod-s3crlca/ (Obtain the S3 key and versions to be used from the shared services team)&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontSize=14;" parent="Qi_sAsrP5YPHp-HeFYlL-38" vertex="1">
          <mxGeometry x="56" width="629" height="72" as="geometry" />
        </mxCell>
        <mxCell id="Qi_sAsrP5YPHp-HeFYlL-40" value="14" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" parent="Qi_sAsrP5YPHp-HeFYlL-38" vertex="1">
          <mxGeometry x="-4" y="12" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="wpx-xS0hVz5jo0oU1wxI-14" value="An AWS API gateway (Regional, REST) is used as the API provider for APIC. This API gateway acts as e&lt;span style=&quot;background-color: initial;&quot;&gt;ntry point into the SFS LZ and provide&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Security features - WAF, mTLS, custom authorization. Since the actual APIM functionalities are handled in APIC, the application may choose to use a simple HTTP PROXY integration to the ALB without managing the OpenAPI schema in AWS gateway. Gateway authorizer&amp;nbsp; cache could be enabled for performance (use certificate serial number as principal/key for cache). The gateway should be configured to disable access via default domain to ensure proper mTLS connectivity.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;fontSize=14;" parent="wpx-xS0hVz5jo0oU1wxI-25" vertex="1">
          <mxGeometry x="987" y="154" width="629" height="150.00000000000003" as="geometry" />
        </mxCell>
        <mxCell id="wpx-xS0hVz5jo0oU1wxI-15" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" parent="wpx-xS0hVz5jo0oU1wxI-25" vertex="1">
          <mxGeometry x="927" y="154" width="36" height="36" as="geometry" />
        </mxCell>
        <mxCell id="O1lpKhGSZu71qgQ_a9Vs-6" value="comments" parent="0" />
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
